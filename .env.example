# ---- Email delivery ----
# Two transports; the script prefers Resend if RESEND_API_KEY is set, else SMTP.
#
# RECOMMENDED on Railway (and any host that blocks SMTP egress on ports 25/465/587):
# Resend sends over HTTPS (443), so it works where SMTP is blocked.
#   1. Sign up at resend.com, create an API key.
#   2. EMAIL_FROM must be either a verified-domain sender (verify fivexcollective.com
#      in Resend to send from contact@fivexcollective.com to anyone), OR
#      "onboarding@resend.dev" — but that only delivers to your Resend account email.
RESEND_API_KEY=re_your_api_key
EMAIL_TO=jxenakis@hotmail.com
EMAIL_FROM=onboarding@resend.dev

# SMTP fallback (works locally; blocked on Railway). Gmail needs an App Password,
# entered WITHOUT the display spaces (16 chars).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=yourapppassword

# ---- Model knobs (optional; sensible defaults baked in) ----
# SEASON_START=2026-03-01
# LEAGUE_HALF_SCORELESS=0.72
# PRIOR_K=10
# LEAGUE_OFF_SCORELESS=0.72
# TEAM_PRIOR_K=8
# MIN_STARTS_CONF=5
# MODEL_MIN_PROB=0.55
# EDGE_MIN=0.03
# REQUIRE_CONFIRMED_LINEUPS=1   # only let games with posted lineups into parlays (late-run guard)

# ---- Optional book lines for edge/EV ----
# Path to a JSON file: [{"match":"Away Team @ Home Team","nrfi":-115,"yrfi":-105}, ...]
# ODDS_FILE=lines.json

# ---- Testing ----
# SCAN_DATE=2026-08-08   # force a specific date instead of "today"
