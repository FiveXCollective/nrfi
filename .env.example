# ---- Email (required to actually send) ----
# Gmail: make an App Password (not your login pw). Or reuse your ATR scanner SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_app_password
EMAIL_TO=jxenakis@hotmail.com
EMAIL_FROM=youraddress@gmail.com

